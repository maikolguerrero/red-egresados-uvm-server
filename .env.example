# =============================================
# Configuración del Servidor
# =============================================
PORT=3000
NODE_ENV=development  # development, production, test
FRONTEND_URL=https://tudominio.com
DOMAIN=.tudominio.com

# =============================================
# Base de Datos (MongoDB)
# =============================================
# Formato: mongodb://usuario:contraseña@host:puerto/nombre_bd
MONGODB_URI=mongodb://localhost:27017/red_egresados_uvm
# Ejemplo para MongoDB Atlas (producción):
# MONGODB_URI=mongodb+srv://usuario:contraseña@clusteruvm.mongodb.net/red_egresados_uvm?retryWrites=true&w=majority

# =============================================
# Autenticación JWT (Tokens)
# =============================================
ACCESS_TOKEN_SECRET=tu_clave_secreta_jwt_32caracteres
REFRESH_TOKEN_SECRET=tu_clave_secreta_jwt_32caracteres
JWT_ACCESS_TOKEN_EXPIRES_IN=30m  # 30m (30 minutos), 1d (1 día), 1h (1 hora)
JWT_REFRESH_TOKEN_EXPIRES_IN=7d # 7d (7 días)
ACCESS_TOKEN_COOKIE_EXPIRES_IN=1800000 # 30 minutos en ms
REFRESH_TOKEN_COOKIE_EXPIRES_IN=604800000 # 7 días en ms

# =============================================
# Correo Electrónico (Nodemailer)
# =============================================
# Configuración para Gmail (usar "Contraseña de aplicación" en Google)
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASSWORD=tu_contraseña_de_aplicacion  # No usar la contraseña personal
EMAIL_FROM_NAME="Red de Egresados UVM"  # Nombre que aparece en los correos
EMAIL_SERVICE=gmail

# =============================================
# Administrador Principal (Solo para desarrollo/primer despliegue)
# =============================================
FIRST_ADMIN_EMAIL=admin@uvm.edu.ve
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=admin123  # Contraseña temporal
FIRST_ADMIN_FULLNAME="Administrador Principal"

# =============================================
# Rutas y Archivos
# =============================================
BASE_URL=http://localhost:3000  # URL del frontend (para enlaces en correos)
CSV_PATH=data/egresados.csv  # Ruta del archivo CSV para carga inicial