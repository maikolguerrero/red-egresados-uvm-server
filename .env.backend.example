# =============================================
# Configuración del Servidor
# =============================================
PORT=3000
NODE_ENV=production  # development, production, testing
FRONTEND_URL=https://localhost:443
API_BASE_URL=http://localhost:3000
DOMAIN=.localhost

# =============================================
# Base de Datos (MongoDB)
# =============================================
MAX_RETRIES=5 # Máximo de reintentos de conexión
MONGODB_URI=mongodb://usuario:contraseña@host:puerto/nombre_bd?authSource=usuario

# =============================================
# Autenticación JWT (Tokens)
# =============================================
ACCESS_TOKEN_SECRET=tu_clave_secreta_jwt_32caracteres
REFRESH_TOKEN_SECRET=tu_clave_secreta_jwt_32caracteres
JWT_ACCESS_TOKEN_EXPIRES_IN=30m  # 1d (1 día), 1h (1 hora), 30m (30 minutos)
JWT_REFRESH_TOKEN_EXPIRES_IN=7d # 7d (7 días)
ACCESS_TOKEN_COOKIE_EXPIRES_IN=1800000 # 30 minutos en ms
REFRESH_TOKEN_COOKIE_EXPIRES_IN=604800000 # 7 días en ms

# Testing Tokens
# JWT_ACCESS_TOKEN_EXPIRES_IN=5s  # 1d (1 día), 1h (1 hora), 30m (15 minutos)
# JWT_REFRESH_TOKEN_EXPIRES_IN=60s # 7d (7 días)
# ACCESS_TOKEN_COOKIE_EXPIRES_IN=5000 # 5 segundos en ms
# REFRESH_TOKEN_COOKIE_EXPIRES_IN=60000 # 60 segundos en ms

# =============================================
# Correo Electrónico (Nodemailer)
# =============================================
# Configuración para Gmail (usar "Contraseña de aplicación" en Google)
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASSWORD=tu_contraseña_de_aplicacion  # No usar la contraseña personal
EMAIL_FROM_NAME="Red de Egresados UVM"  # Nombre que aparece en los correos
EMAIL_SERVICE=gmail

# =============================================
# Subir archivos con Cloudinary (fotos, videos)
# =============================================
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# =============================================
# Administrador Principal (Solo para desarrollo/primer despliegue)
# =============================================
FIRST_ADMIN_EMAIL=tu_correo@tu_correo.com
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=12345678  # Contraseña temporal
FIRST_ADMIN_FULLNAME="Administrador Principal"

# =============================================
# Documentación Swagger
# =============================================
SWAGGER_TITLE="API Red de Egresados UVM"
SWAGGER_VERSION="1.0.0"
SWAGGER_DESCRIPTION="Documentación oficial de la API"